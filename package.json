{
  "name": "agent-editor",
  "displayName": "Agent 编辑器",
  "description": "在 VSCodium 中使用 Pi 了解项目、编辑文件和审阅改动。",
  "publisher": "codebuddy-demo",
  "version": "0.1.0",
  "private": true,
  "engines": { "vscode": "^1.110.0" },
  "main": "./src/extension.js",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": "limited", "description": "信任本地单目录项目后，可使用 AI 上下文、编辑和命令。" },
    "virtualWorkspaces": false
  },
  "activationEvents": ["onStartupFinished"],
  "categories": ["Machine Learning", "Other"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "agentEditor", "title": "Agent 编辑器", "icon": "media/agent.svg" }]
    },
    "views": {
      "agentEditor": [{ "id": "agentEditor.chat", "type": "webview", "name": "AI 对话" }]
    },
    "commands": [
      { "command": "agentEditor.open", "title": "AI：打开对话" },
      { "command": "agentEditor.configure", "title": "AI：配置模型" },
      { "command": "agentEditor.newChat", "title": "AI：新对话" },
      { "command": "agentEditor.history", "title": "AI：历史对话" },
      { "command": "agentEditor.selection", "title": "添加选区到对话" },
      { "command": "agentEditor.quickEdit", "title": "AI 快速编辑" },
      { "command": "agentEditor.complete", "title": "AI：触发 Tab 补全" },
      { "command": "agentEditor.undoRound", "title": "AI：撤销最近一轮 Agent 改动" }
    ],
    "menus": {
      "editor/context": [
        { "command": "agentEditor.selection", "when": "resourceScheme == file && editorHasSelection && isWorkspaceTrusted", "group": "1_modification@8" },
        { "command": "agentEditor.quickEdit", "when": "resourceScheme == file && editorTextFocus && isWorkspaceTrusted", "group": "1_modification@9" }
      ]
    },
    "keybindings": [
      { "command": "agentEditor.quickEdit", "key": "ctrl+i", "when": "editorTextFocus && !editorReadonly && resourceScheme == file && isWorkspaceTrusted" }
    ],
    "configuration": {
      "title": "Agent 编辑器",
      "properties": {
        "agentEditor.tabCompletion": { "type": "boolean", "default": true, "description": "AI Tab 补全：在停顿时显示灰字续写，按 Tab 接受、Esc 取消。" }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package:win": "node scripts/package.mjs",
    "test:editor": "node scripts/test-editor.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "markdown-it": "15.0.3",
    "typebox": "1.3.27"
  }
}
